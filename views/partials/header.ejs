<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== "undefined" ? title : "Lustre & Light" %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Poppins:wght@300;400;500&display=swap">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <nav class="navbar">
      <a href="/" class="logo">Lustre & Light</a>
      <div class="nav-links">
        <a href="/">Home</a>
        <a href="/shop">Shop</a>
        <a href="/cart">Cart<% if (cartCount > 0) { %> <span class="cart-badge"><%= cartCount %></span><% } %></a>
        <% if (currentUser) { %><span class="hello">Hi, <%= currentUser.name.split(" ")[0] %></span><form method="POST" action="/logout" class="logout-form"><button type="submit">Logout</button></form><% } else { %><a href="/login">Login</a><% } %>
      </div>
    </nav>
  </header>
