<%- include("partials/header", { title: "Checkout | Lustre & Light" }) %>

<h1 class="page-title">Checkout</h1>

<div class="cart-wrap">
  <form method="POST" action="/checkout" class="checkout-form">
    <h2>Delivery Details</h2>

    <% if (error) { %><p class="form-error"><%= error %></p><% } %>

    <label>Name</label>
    <input type="text" value="<%= currentUser.name %>" disabled>

    <label>Delivery address</label>
    <textarea name="address" rows="3" required minlength="10" placeholder="House no., street, area, city"><%= form.address || '' %></textarea>

    <label>Phone number</label>
    <input type="tel" name="phone" value="<%= form.phone || '' %>" required placeholder="03xx xxxxxxx">

    <label>Payment method</label>
    <div class="pay-box"><input type="radio" checked disabled> Cash on Delivery</div>

    <button type="submit" class="btn full">Place Order</button>
  </form>

  <aside class="cart-summary">
    <h2>Your Order</h2>
    <% items.forEach(function (it) { %>
      <div class="sum-row"><span><%= it.product.name %> x <%= it.qty %></span><span>Rs. <%= it.subtotal.toLocaleString() %></span></div>
    <% }); %>
    <div class="sum-row"><span>Delivery</span><span>Free</span></div>
    <div class="sum-row total"><span>Total</span><span>Rs. <%= total.toLocaleString() %></span></div>
  </aside>
</div>

<%- include("partials/footer") %>
