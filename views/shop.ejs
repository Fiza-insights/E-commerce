<%- include("partials/header", { title: "Shop | Lustre & Light" }) %>

<h1 class="page-title">Our Collection</h1>

<form method="GET" action="/shop" class="filters">
  <input type="text" name="q" placeholder="Search jewellery..." value="<%= q %>">
  <select name="category">
    <option value="">All categories</option>
    <% categories.forEach(function (c) { %>
      <option value="<%= c.id %>" <%= String(c.id) === String(category) ? "selected" : "" %>><%= c.name %></option>
    <% }); %>
  </select>
  <input type="number" name="min" placeholder="Min Rs." value="<%= min %>">
  <input type="number" name="max" placeholder="Max Rs." value="<%= max %>">
  <button type="submit" class="btn">Filter</button>
  <a href="/shop" class="clear-btn"><span>&#10005;</span> Clear all</a>
</form>

<p class="result-count"><%= products.length %> items found</p>

<% if (products.length === 0) { %>
  <p class="empty">No jewellery found. Try changing your filters.</p>
<% } else { %>
  <div class="product-grid">
    <% products.forEach(function (p) { %>
      <a href="/product/<%= p.id %>" class="product-card">
        <div class="product-img">
          <img src="/images/products/<%= p.image %>" alt="<%= p.name %>">
        </div>
        <p class="cat-label"><%= p.category_name %></p>
        <h3><%= p.name %></h3>
        <p class="rating"><span class="stars"><%= stars(p.avg_rating) %></span> <small>(<%= p.review_count %>)</small></p>
        <p class="price">Rs. <%= p.price.toLocaleString() %></p>
        <% if (p.stock === 0) { %>
          <p class="out">Out of stock</p>
        <% } %>
      </a>
    <% }); %>
  </div>
<% } %>

<%- include("partials/footer") %>
